# Platform/runtime
PORT=3000
DATABASE_URL=mysql://user:password@host:3306/intentlock
APP_ID=
APP_SECRET=

# INTENTLOCK mandate integrity
MANDATE_HASH_SECRET=replace-with-a-long-random-secret

# Optional PayPal sandbox credentials. The starter runs in simulated-sandbox mode without them.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Platform AI gateway is injected by Kimi when available. Never expose these to the browser.
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=
